# ── Tienda NOVA MODA (frontend) ─────────────────────────────────
# Copia este archivo como .env.local y completa los valores.

# URL pública del API de POWERGY. El proxy del sitio la usa en el servidor
# (nunca la ve el navegador y no hace falta configurar CORS).
POWERGY_API_URL=https://powergy.somee.com

# Tienda con la que se consultan catálogo, categorías y solicitudes.
NEXT_PUBLIC_NOVA_STORE=nova-moda

# Supabase (mismo proyecto que POWERGY): acceso del panel /admin y Storage
# para las imágenes de producto.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=powergy-product-images

# WhatsApp que recibe los pedidos (solo dígitos, con código de país).
NEXT_PUBLIC_WHATSAPP_PHONE=5359749037
